# Server environment only. Never use a VITE_ prefix for secrets.
CHATBASE_API_KEY=
CHATBASE_BOT_ID=
# Set false and redeploy to disable the relay during an incident.
CHAT_ENABLED=true
# For local development, use a local backend or an approved preview backend.
# Production deliberately rejects localhost origins.
# VITE_CHAT_API_URL=http://localhost:3000/api/chat
